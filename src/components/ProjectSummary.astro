---
import SummaryCard from "./ui/SummaryCard.astro";
import type { CollectionEntry } from "astro:content";
interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
---

<SummaryCard title={project.data.title} href={"/projects/" + project.id + "/"}>
  <p slot="eyebrow" class="eyebrow">
    {project.data.employer}
  </p>
  <p>{project.data.description}</p>
</SummaryCard>
