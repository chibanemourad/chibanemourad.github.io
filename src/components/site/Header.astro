---
import ThemeSelector from "../ThemeSelector.astro";
const links = [
  ["About", "/about/"],
  ["Projects", "/projects/"],
  ["Writing", "/blog/"],
];
---

<header>
  <a class="brand" href="/">
    MC<span> / Technical lead</span>
  </a>
  <div class="header-actions">
    <nav aria-label="Main">
      {links.map(([label, url]) => (
        <a
          href={url}
          aria-current={Astro.url.pathname.startsWith(url) ? "page" : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
    <ThemeSelector />
  </div>
</header>
