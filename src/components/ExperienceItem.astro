---
import SummaryCard from "./ui/SummaryCard.astro";
import type { Experience } from "../data/profile";
interface Props {
  experience: Experience;
}
const { experience } = Astro.props;
---

<SummaryCard title={experience.role}>
  <p slot="eyebrow" class="eyebrow">
    {experience.period}
  </p>
  <p>
    <strong>{experience.employer}</strong>
  </p>
  {experience.summary && <p>{experience.summary}</p>}
</SummaryCard>
