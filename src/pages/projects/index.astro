---
import SummaryCard from "../../components/ui/SummaryCard.astro";
import Base from "../../layouts/Base.astro";
import { projects } from "../../lib/content";
const entries = await projects();
---

<Base title="Projects">
  <p class="eyebrow">Selected work</p>
  <h1>Projects.</h1>
  {entries.length ? (
    entries.map((p) => (
      <SummaryCard
        title={p.data.title}
        href={"/projects/" + p.id + "/"}
        headingLevel="h2"
      >
        <p>{p.data.description}</p>
      </SummaryCard>
    ))
  ) : (
    <p> Project case studies are being prepared. Check back soon.</p>
  )}
</Base>
