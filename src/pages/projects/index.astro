---
import Base from "../../layouts/Base.astro";
import { projects } from "../../lib/content";
const entries = await projects();
---

<Base title="Projects">
  <p class="eyebrow">Selected work</p>
  <h1>Projects.</h1>
  {entries.length ? (
    entries.map((p) => (
      <article class="card">
        <h2>
          <a href={"/projects/" + p.id + "/"}>{p.data.title}</a>
        </h2>
        <p>{p.data.description}</p>
      </article>
    ))
  ) : (
    <p> Project case studies are being prepared. Check back soon.</p>
  )}
</Base>
