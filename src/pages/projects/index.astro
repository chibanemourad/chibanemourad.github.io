---
import Base from "../../layouts/Base.astro";
import { projects } from "../../lib/content";
const entries = await projects();
---

<Base title="Projects">
  <div class="article-shell project-list">
    <div class="article-heading">
      <p class="eyebrow">Selected work</p>
      <h1>Projects.</h1>
    </div>
    {entries.length ? (
      entries.map((p) => (
        <article class="project-list-entry">
          <p class="eyebrow">{p.data.employer}</p>
          <h2>
            <a href={"/projects/" + p.id + "/"}>{p.data.title}</a>
          </h2>
          <p>{p.data.description}</p>
          <a
            class="project-read"
            href={"/projects/" + p.id + "/"}
            aria-label={"Read case study: " + p.data.title}
          >
            Read case study <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    ) : (
      <p>Project case studies are being prepared. Check back soon.</p>
    )}
  </div>
</Base>
