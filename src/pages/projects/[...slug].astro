---
import Tag from "../../components/ui/Tag.astro";
import Base from "../../layouts/Base.astro";
import { render } from "astro:content";
import { projects } from "../../lib/content";
export async function getStaticPaths() {
  return (await projects()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <div class="article-shell">
    <div class="article-heading">
      <a class="article-back" href="/projects/">
        ← Back to projects
      </a>
      <p class="eyebrow">Selected work · Case study</p>
      <h1>{entry.data.title}</h1>
      <p class="article-deck">{entry.data.description}</p>
    </div>
    <aside class="project-context" aria-label="Project context">
      <dl>
        <div>
          <dt>Organization</dt>
          <dd>{entry.data.employer}</dd>
        </div>
        <div>
          <dt>Role</dt>
          <dd>{entry.data.role}</dd>
        </div>
      </dl>
      <p class="eyebrow">Technologies</p>
      <ul class="technologies">
        {entry.data.technologies.map((technology) => (
          <li>
            <Tag>{technology}</Tag>
          </li>
        ))}
      </ul>
    </aside>
    <article class="prose article-body">
      <Content />
    </article>
  </div>
</Base>
