---
import SummaryCard from "../../components/ui/SummaryCard.astro";
import Base from "../../layouts/Base.astro";
import { articles } from "../../lib/content";
const entries = await articles();
---

<Base title="Writing">
  <p class="eyebrow">Notes & ideas</p>
  <h1>Writing.</h1>
  {entries.length ? (
    entries.map((p) => (
      <SummaryCard
        title={p.data.title}
        href={"/blog/" + p.id + "/"}
        headingLevel="h2"
      >
        <p>{p.data.description}</p>
      </SummaryCard>
    ))
  ) : (
    <p> Articles are being prepared. Check back soon.</p>
  )}
</Base>
