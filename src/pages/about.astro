---
import ActionLink from "../components/ui/ActionLink.astro";
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";
const current = profile.experience[0];
---

<Base title="About" description={profile.description}>
  <div class="about-page">
    <section class="about-hero" aria-labelledby="about-title">
      <div>
        <p class="eyebrow">About · {profile.location}</p>
        <h1 id="about-title">
          Hi, I'm Mourad.
          <br />
          <em>
            Engineer. Architect.
            <br />
            Technical lead.
          </em>
        </h1>
        <p class="about-lead">
          Over a decade building software, designing architectures, and helping
          engineering teams work more effectively.
        </p>
        <div class="home-actions">
          <ActionLink href={profile.resume}>View résumé ↗</ActionLink>
          <a href="#experience">Explore my experience ↓</a>
        </div>
      </div>
      <aside class="about-current" aria-label="Current role">
        <p class="eyebrow">Currently</p>
        <h2>{current.role}</h2>
        <p>{current.employer}</p>
        <p class="muted">{current.period}</p>
        <p>
          Working at the intersection of architecture, hands-on engineering, and
          developer experience.
        </p>
      </aside>
    </section>
    <section class="about-story" aria-labelledby="approach-title">
      <div>
        <p class="eyebrow">Perspective</p>
        <h2 id="approach-title">Making complexity manageable.</h2>
      </div>
      <div class="about-story-copy">
        <p>
          I've spent much of my career building software for medical devices,
          where reliability, maintainability, and thoughtful engineering
          decisions matter. I've also worked in climate technology, helping turn
          complex carbon data into useful product features.
        </p>
        <p>
          My focus has grown from writing application code to understanding how
          systems fit together and how teams collaborate. Clear
          responsibilities, sensible abstractions, automated checks, and
          documented decisions make software easier to evolve.
        </p>
        <p>
          I stay close to implementation. Code review, mentoring, and
          constructive technical discussions are part of the same work: helping
          people build software that the next developer can understand and
          change confidently.
        </p>
      </div>
    </section>
    <section
      class="about-section"
      id="experience"
      aria-labelledby="experience-title"
    >
      <div class="home-section-heading">
        <div>
          <p class="eyebrow">Career</p>
          <h2 id="experience-title">Experience</h2>
        </div>
        <p class="muted">From hands-on development to cross-team leadership.</p>
      </div>
      <div class="career-timeline">
        {profile.experience.map((experience) => (
          <article class="career-entry">
            <p class="career-period">{experience.period}</p>
            <div class="career-description">
              <p class="eyebrow">{experience.employer}</p>
              <h3>{experience.role}</h3>
              {experience.summary && <p>{experience.summary}</p>}
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="about-section" aria-labelledby="skills-title">
      <div class="home-section-heading">
        <div>
          <p class="eyebrow">Technical breadth</p>
          <h2 id="skills-title">What I work with</h2>
        </div>
      </div>
      <div class="about-skills">
        {profile.expertise.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>
    <div class="about-background">
      <section aria-labelledby="education-title">
        <p class="eyebrow">Background</p>
        <h2 id="education-title">Education</h2>
        {profile.education.map((item) => (
          <p>{item}</p>
        ))}
      </section>
      <section aria-labelledby="languages-title">
        <p class="eyebrow">Communication</p>
        <h2 id="languages-title">Languages</h2>
        <ul>
          {profile.languages.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    </div>
    <section class="about-connect" aria-labelledby="connect-title">
      <div>
        <p class="eyebrow">Keep in touch</p>
        <h2 id="connect-title">Let's connect</h2>
        <p>
          Interested in software architecture, engineering practices, or sharing
          ideas?
        </p>
      </div>
      <div class="home-actions">
        <a href={profile.linkedin}>LinkedIn ↗</a>
        <a href={profile.github}>GitHub ↗</a>
      </div>
    </section>
  </div>
</Base>
