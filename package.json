    "prebuild": "npm run tokens:build"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "style-dictionary": "5.7.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
