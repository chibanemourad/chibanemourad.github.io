{
  "name": "mourad-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "npm run tokens:check && astro check && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
